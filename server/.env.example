# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local: mongodb://127.0.0.1:27017/stock_system
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/stock_system
MONGO_URI=mongodb://127.0.0.1:27017/stock_system

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Replenishment engine defaults (can be overridden per product)
DEFAULT_SAFETY_DAYS=3
DEFAULT_LEAD_TIME_DAYS=5
SALES_ANALYSIS_WINDOW_DAYS=30
